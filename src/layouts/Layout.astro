---
import '../styles/global.css';
import 'aos/dist/aos.css';
import { imageSizeFromFile } from 'image-size/fromFile';

const { pageTitle } = Astro.props;

const defaultFavicon = '/res/favicon.png';
const imageDimensions = await imageSizeFromFile('./public' + defaultFavicon);

const siteTitle = import.meta.env.PUBLIC_APP_NAME;
const formattedTitle = pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle;
const siteDescription =
    'Faizal Chan, a strong design management professional with a master of management degree, focused in UX from Telkom University.';
const siteUrl = import.meta.env.PUBLIC_SITE_URL.replace(/\/+$/, '');

const openGraph = {
    siteName: "Faizal Chan's Website",
    description: 'Main website of Faizal Chan.',
    image: {
        url: defaultFavicon,
        width: imageDimensions?.width,
        height: imageDimensions?.height,
    },
    type: 'website',
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href={defaultFavicon} />

        <title>{formattedTitle}</title>
        <meta name="description" content={siteDescription} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:title" content={formattedTitle} />
        <meta property="og:site_name" content={openGraph.siteName} />
        <meta property="og:description" content={openGraph.description} />
        <meta property="og:image:url" content={openGraph.image.url} />
        <meta property="og:image:width" content={openGraph.image.width} />
        <meta property="og:image:height" content={openGraph.image.height} />
        <meta property="og:type" content={openGraph.type} />
        <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />

        <script
            src="https://www.googletagmanager.com/gtag/js?id=UA-131278165-1"
            async></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'UA-131278165-1');
        </script>
    </head>

    <body
        class="flex flex-col justify-center items-center w-full min-h-screen overflow-auto"
        data-theme="light"
    >
        <div style="display: contents">
            <slot />
        </div>
    </body>
</html>
